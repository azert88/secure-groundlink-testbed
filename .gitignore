# ---------------------------------------------------------------- secrets and private material
.env
keys/private/

# ---------------------------------------------------------------- local environment and tools
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
challenge_docs/
notes.txt
# challenge material kept in docs/ (slides, specification book, resource list; hold organiser contacts)
docs/Capture d*.png
docs/Ground*Truth*.pdf

# ---------------------------------------------------------------- data: large, rebuilt, or not redistributable
# raw SatNOGS files are never redistributed (decision 29); only the per-file manifest is kept
data/raw/*
!data/raw/manifest.csv
# rebuilt by the pipeline from raw + recipes (fingerprints in data/DATA.md section 8)
data/features/
data/tables/
data/labels/
data/cache/
data/validation/cues/
data/explore/

# ---------------------------------------------------------------- audio anywhere in the tree
*.ogg
*.wav
*.flac
*.mp3
*.opus

# window caches with labels, rebuilt by eval/interference_eval.py cache
eval/out/interference/cache_*.pkl

# demo sample: 2 small observations with sanitized metadata (data/make_sample.py)
!data/sample/*/audio.ogg

# local outputs of the demo and the CLIs
/out/
